---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getPosts, formatDate } from '../posts';

const gh = 'https://github.com/abhi-node';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const recent = (await getPosts()).slice(0, 3);

// A card opens its write-up if there is one, otherwise the demo or repo.
const linkFor = (p: (typeof projects)[number]) =>
  p.data.post ? `/posts/${p.data.post.id}/` : (p.data.demo ?? p.data.repo ?? '#');
const labelFor = (p: (typeof projects)[number]) =>
  p.data.post ? 'write-up →' : p.data.demo ? 'demo ↗' : 'github ↗';
---

<Base>
  <section class="hero">
    <h1>Abhijith Balagurusamy</h1>
    <p class="meta">software engineer · computer engineering @ uoft</p>
    <p>
      I build real-time systems and backend infrastructure. I started programming in fourth
      grade, got hooked through competitive programming, and taught intro computer science
      classes in middle and high school.
    </p>
    <p>
      I love the parts of programming close to the machine or deep in the math: performance
      engineering, compilers, operating systems, computer architecture, machine learning,
      reinforcement learning and game theory. My favorite way to learn something is to build it
      from scratch.
    </p>
  </section>

  <h2 id="projects">Projects</h2>
  <div class="grid">
    {projects.map((p) => {
      const href = linkFor(p);
      const external = !href.startsWith('/');
      return (
        <a class="card" href={href} {...(external && { target: '_blank', rel: 'noopener' })}>
          <div class="thumb">
            {p.data.image
              ? <Image src={p.data.image} alt={p.data.title} widths={[400, 800]} sizes="(max-width: 600px) 100vw, 370px" />
              : <span>{p.data.title}</span>}
          </div>
          <div class="card-body">
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <div class="card-foot">
              <span>{p.data.tags.join(' · ')}</span>
              <span>{labelFor(p)}</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <h2>Work</h2>
  <ul class="roles">
    <li>
      <span><strong>Crossover / Alpha School</strong> <span class="role">· Software Engineer (full-time co-op)</span></span>
      <time>Sep 2025 – Aug 2026</time>
    </li>
    <li>
      <span><strong>Gauntlet AI</strong> <span class="role">· Software Engineering Fellow</span></span>
      <time>Jun 2025 – Aug 2025</time>
    </li>
    <li>
      <span><strong>Beth Israel Deaconess Medical Center</strong> <span class="role">· Data Science Intern</span></span>
      <time>Jun 2024 – Aug 2024</time>
    </li>
  </ul>

  {recent.length > 0 && (
    <>
      <h2>Recent posts</h2>
      <ul class="post-list">
        {recent.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      <p><a href="/posts/" class="more">all posts →</a></p>
    </>
  )}

  <h2>Contact</h2>
  <p>
    <a href={gh}>GitHub</a> · <a href="https://www.linkedin.com/in/abhijith-balagurusamy-46ab47248/">LinkedIn</a> · abhibalagurusamy@gmail.com
  </p>
</Base>
